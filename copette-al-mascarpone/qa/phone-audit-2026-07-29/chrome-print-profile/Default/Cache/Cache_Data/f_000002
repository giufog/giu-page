:root {
  --forest: #173e35;
  --sage: #4d8a70;
  --action: #217a46;
  --soft: #e5f0e8;
  --page: #f1f6f1;
  --line: #d8e5dc;
  --muted: #64756b;
  --ink: #17332c;
  --white: #fff;
  --red: #b23a3a;
  --blue: #2878b8;
  --radius-sm: 8px;
  --radius: 12px;
  --radius-lg: 18px;
  --content: 760px;
  --site: 1180px;
  --shadow: 0 10px 28px rgb(23 62 53 / 7%);
  --shadow-hover: 0 14px 34px rgb(23 62 53 / 12%);
  color: var(--ink);
  background: var(--page);
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-synthesis: none;
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; scroll-padding-top: 92px; }
body { min-width: 320px; margin: 0; color: var(--ink); background: var(--page); font-size: 16px; line-height: 1.58; }
a { color: var(--action); }
button, input { font: inherit; }
button, summary { cursor: pointer; }
button, summary, a { -webkit-tap-highlight-color: transparent; }
img { display: block; max-width: 100%; }
:focus-visible { outline: 3px solid rgb(77 138 112 / 35%); outline-offset: 3px; }

.skip-link {
  position: fixed;
  z-index: 100;
  top: 8px;
  left: 8px;
  transform: translateY(-150%);
  padding: 9px 12px;
  border-radius: var(--radius-sm);
  color: var(--forest);
  background: var(--white);
  box-shadow: var(--shadow);
}
.skip-link:focus { transform: none; }

.site-header {
  position: sticky;
  z-index: 60;
  top: 0;
  border-bottom: 1px solid rgb(255 255 255 / 16%);
  background: rgb(23 62 53 / 97%);
  backdrop-filter: blur(14px);
}
.site-header__inner {
  display: flex;
  min-height: 64px;
  width: min(var(--site), 100%);
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin: auto;
  padding: 10px 20px;
}
.brand {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  color: var(--white);
  font-size: 1.05rem;
  font-weight: 800;
  letter-spacing: -.01em;
  text-decoration: none;
}
.brand:hover { color: var(--white); }
.brand__mark { width: 34px; height: 34px; flex: 0 0 34px; border-radius: 10px; object-fit: contain; }
.header-actions { display: flex; align-items: center; gap: 8px; }
.icon-button {
  display: inline-grid;
  width: 44px;
  height: 44px;
  place-items: center;
  padding: 0;
  border: 1px solid rgb(255 255 255 / 22%);
  border-radius: var(--radius);
  color: var(--white);
  background: transparent;
}
.icon-button:hover { background: rgb(255 255 255 / 12%); }
.icon-button svg, .button svg {
  width: 19px;
  height: 19px;
  fill: none;
  stroke: currentColor;
  stroke-linecap: round;
  stroke-linejoin: round;
  stroke-width: 1.8;
}
.menu { position: relative; }
.menu summary { list-style: none; }
.menu summary::-webkit-details-marker { display: none; }
.menu__panel {
  position: absolute;
  top: calc(100% + 8px);
  right: 0;
  display: grid;
  width: 250px;
  padding: 6px;
  border: 1px solid var(--line);
  border-radius: var(--radius);
  background: var(--white);
  box-shadow: var(--shadow-hover);
}
.menu__panel a {
  display: grid;
  grid-template-columns: 25px minmax(0, 1fr);
  align-items: center;
  gap: 7px;
  padding: 10px 11px;
  border-radius: var(--radius-sm);
  color: var(--ink);
  font-size: .92rem;
  text-align: left;
  text-decoration: none;
}
.menu__panel a:hover { background: var(--soft); }
.menu__panel a span { color: var(--sage); font-size: .7rem; font-weight: 850; letter-spacing: .04em; }
.page-search { border-top: 1px solid rgb(255 255 255 / 13%); color: var(--white); background: var(--forest); }
.page-search[hidden] { display: none; }
.page-search__inner { width: min(var(--content), 100%); margin: auto; padding: 12px 20px 16px; }
.page-search__inner label { display: block; color: rgb(255 255 255 / 76%); font-size: .76rem; font-weight: 800; }
.page-search__control { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 8px; margin-top: 6px; }
.page-search__control input {
  min-width: 0;
  min-height: 44px;
  padding: 9px 12px;
  border: 1px solid rgb(255 255 255 / 28%);
  border-radius: var(--radius);
  outline: none;
  color: var(--ink);
  background: var(--white);
}
.page-search__control input:focus { border-color: #9be878; box-shadow: 0 0 0 3px rgb(155 232 120 / 24%); }
.page-search__control button {
  min-height: 44px;
  padding: 9px 15px;
  border: 1px solid rgb(255 255 255 / 30%);
  border-radius: var(--radius);
  color: var(--forest);
  background: var(--soft);
  font-weight: 800;
}
.page-search__status { margin: 6px 0 0; color: rgb(255 255 255 / 72%); font-size: .76rem; }

.hero {
  padding: 44px max(20px, calc((100vw - var(--site)) / 2));
  color: var(--white);
  background: linear-gradient(115deg, var(--forest), #285e4e 62%, var(--sage));
}
.hero > * { max-width: var(--content); }
.hero h1 {
  max-width: 17ch;
  margin: 0;
  color: var(--white);
  font-size: clamp(2.25rem, 8vw, 4.35rem);
  line-height: 1.03;
  letter-spacing: -.045em;
}
.hero__lead { margin: 18px 0 0; color: rgb(255 255 255 / 86%); font-size: clamp(1rem, 2.8vw, 1.2rem); }
.page-meta { display: flex; flex-wrap: wrap; gap: 5px 9px; margin-top: 17px; color: rgb(255 255 255 / 70%); font-size: .86rem; }
.hero__actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 19px; }
.button {
  display: inline-flex;
  min-height: 44px;
  min-width: 158px;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 10px 15px;
  border: 1px solid rgb(255 255 255 / 48%);
  border-radius: var(--radius);
  background: var(--white);
  box-shadow: 0 7px 16px rgb(0 0 0 / 13%);
  font-size: .93rem;
  font-weight: 800;
  text-decoration: none;
  transition: transform .16s ease, border-color .16s ease, background .16s ease;
}
.button:hover { transform: translateY(-1px); border-color: var(--white); background: var(--soft); }
.button--print { color: var(--red); }
.button--share { color: var(--blue); }

.page-shell { width: min(var(--content), 100%); min-width: 0; margin: auto; padding: 34px 20px 76px; }
.article { width: 100%; min-width: 0; }
.article > section { scroll-margin-top: 92px; margin-top: 46px; }
.article > section:first-of-type { margin-top: 26px; }
.content-column, .wide-section { width: 100%; margin-inline: 0; }

.research-note,
.structure,
.health,
.sources {
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
  background: var(--white);
  box-shadow: 0 6px 18px rgb(23 62 53 / 4%);
}
.research-note { padding: 17px 18px; }
.research-note p { margin: 6px 0 0; }
.structure { padding: 20px; }
.kicker { margin: 0 0 8px; color: var(--action); font-size: .78rem; font-weight: 850; letter-spacing: .12em; text-transform: uppercase; }
.structure h2,
.section-heading h2,
.recipe h2,
.health h2 {
  margin: 0;
  font-size: clamp(1.6rem, 5vw, 2.25rem);
  line-height: 1.13;
  letter-spacing: -.03em;
}
.fact-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 1px;
  margin: 20px 0 0;
  border: 1px solid var(--line);
  background: var(--line);
}
.fact-grid div { padding: 16px; background: var(--white); }
.fact-grid dt { color: var(--muted); font-size: .78rem; letter-spacing: .08em; text-transform: uppercase; }
.fact-grid dd { margin: 5px 0; font-size: 1rem; font-weight: 800; }
.fact-grid small { display: block; color: var(--muted); }

.section-heading > p:last-child { margin-bottom: 0; color: var(--muted); font-size: 1.02rem; }
.variant-grid { display: grid; gap: 14px; margin-top: 22px; }
.variant-card {
  display: grid;
  grid-template-columns: 220px 1fr;
  overflow: hidden;
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
  color: var(--ink);
  background: var(--white);
  text-decoration: none;
  transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease;
}
.variant-card:hover { transform: translateY(-2px); border-color: #b7d1bf; box-shadow: var(--shadow); }
.variant-card img { width: 100%; height: 100%; min-height: 218px; object-fit: cover; }
.variant-card > div { display: flex; min-width: 0; flex-direction: column; justify-content: center; padding: 22px; }
.variant-card h3 { margin: 0 0 8px; font-size: 1.25rem; line-height: 1.18; }
.variant-card p { margin: 0; color: var(--muted); }
.variant-time {
  display: grid;
  grid-template-columns: minmax(100px, auto) 1fr;
  align-items: start;
  gap: 14px;
  margin-top: 18px !important;
  padding-top: 14px;
  border-top: 1px solid var(--line);
}
.variant-time strong { color: var(--ink); white-space: nowrap; }
.variant-time span { color: var(--muted); }

.recipe { padding-top: 4px; }
.recipe-intro { display: grid; grid-template-columns: 1.05fr .95fr; align-items: start; gap: 24px; }
.recipe-intro > div > p { font-size: 1.02rem; }
.recipe-intro figure { margin: 0; }
.recipe-intro img { width: 100%; aspect-ratio: 4 / 3; border-radius: var(--radius-lg); object-fit: cover; }
.recipe-intro figcaption { margin-top: 7px; color: var(--muted); font-size: .75rem; }
.callout { padding: 14px 16px; border-radius: var(--radius); color: var(--forest); background: var(--soft); }
.recipe-meta {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(132px, 1fr));
  gap: 1px;
  margin: 22px 0 32px;
  border: 1px solid var(--line);
  background: var(--line);
}
.recipe-meta div { min-width: 0; padding: 14px; background: var(--white); }
.recipe-meta .total { background: var(--soft); }
.recipe-meta dt { color: var(--muted); font-size: .7rem; letter-spacing: .06em; text-transform: uppercase; }
.recipe-meta dd { margin: 3px 0 0; font-weight: 800; overflow-wrap: anywhere; }
.recipe h3 { margin: 38px 0 14px; font-size: 1.35rem; }
.ingredient-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
.ingredient-grid article { padding: 16px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--white); }
.ingredient-grid b, .ingredient-grid span { display: block; }
.ingredient-grid b { margin-bottom: 8px; }
.ingredient-grid span { color: var(--muted); font-size: .9rem; }
.tools { display: flex; flex-wrap: wrap; gap: 9px; margin: 0; padding: 0; list-style: none; }
.tools li { padding: 8px 11px; border: 1px solid var(--line); border-radius: var(--radius-sm); background: var(--soft); }
.steps { margin: 0; padding: 0; list-style: none; }
.steps li { display: grid; grid-template-columns: 48px 1fr; gap: 16px; padding: 22px 0; border-top: 1px solid var(--line); }
.steps li > span {
  display: grid;
  width: 44px;
  height: 44px;
  place-items: center;
  border-radius: 10px;
  color: var(--white);
  background: var(--forest);
  font-weight: 800;
}
.steps h4 { margin: 0; font-size: 1.15rem; }
.steps time { float: right; color: var(--action); font-size: .85rem; font-weight: 700; }
.steps p { margin: 8px 0; color: #3a554d; }
.source-note { padding: 17px 18px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--white); }

.health { padding: 20px 20px 0; }
.legend { display: flex; flex-wrap: wrap; gap: 10px 18px; margin: 20px 0 18px; font-size: .86rem; }
.legend span { display: inline-flex; align-items: center; gap: 7px; }
.dot { width: 10px; height: 10px; flex: 0 0 10px; border: 1px solid #aebdb3; border-radius: 50%; background: var(--white); }
.dot.alert, .chip.alert { border-color: #e8a29a; color: #8c2822; background: #fde8e6; }
.dot.watch, .chip.watch { border-color: #e6ca87; color: #76570e; background: #fff3d7; }
.dot.good, .chip.good { border-color: #9fcbb0; color: #1b6037; background: #e0f2e6; }
.table-method { margin: 0 0 20px; padding: 14px 16px; border-left: 4px solid var(--sage); color: var(--muted); background: #f7faf7; font-size: .9rem; }
.table-wrap {
  width: calc(100vw - 32px);
  max-width: var(--site);
  margin-left: 50%;
  overflow: auto;
  transform: translateX(-50%);
  border: 1px solid var(--line);
  border-radius: 12px 12px var(--radius-lg) var(--radius-lg);
  background: var(--white);
  box-shadow: 0 12px 26px rgb(23 62 53 / 7%);
}
table { width: 100%; min-width: 1100px; border-collapse: collapse; font-size: .86rem; }
th, td { padding: 16px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); vertical-align: top; text-align: left; }
tr > :last-child { border-right: 0; }
tbody tr:last-child > * { border-bottom: 0; }
thead th {
  position: sticky;
  z-index: 1;
  top: 0;
  color: var(--white);
  background: var(--forest);
  font-size: .74rem;
  letter-spacing: .04em;
  text-transform: uppercase;
}
tbody th { width: 190px; background: #f8fbf8; }
tbody th b, tbody th small, tbody th em { display: block; }
tbody th small { margin-top: 6px; color: #4e655e; }
tbody th em { margin-top: 8px; color: var(--muted); font-size: .72rem; font-weight: 400; }
.chip { display: block; margin-bottom: 5px; padding: 6px 8px; border: 1px solid var(--line); border-radius: 7px; background: var(--white); }

.sources-section { margin-top: 32px !important; }
.sources { overflow: hidden; }
.sources summary {
  display: flex;
  min-height: 54px;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 14px 17px;
  font-weight: 850;
}
.sources summary small { color: var(--muted); font-weight: 600; }
.sources > div { padding: 16px 20px 20px; border-top: 1px solid var(--line); }
.sources > div > p { margin: 0 0 10px; color: var(--muted); }
.sources ol { margin: 0; padding-left: 22px; }
.sources li { padding: 10px 0; }
.sources li a { font-weight: 800; }
.sources li p { margin: 3px 0 0; color: var(--muted); }

.site-footer { padding: 0; border-top: 1px solid var(--line); color: var(--ink); background: var(--white); }
.site-footer div { display: grid; width: min(var(--site), 100%); gap: 2px; margin: auto; padding: 24px 20px 34px; }
.site-footer b { font-size: .9rem; }
.site-footer span { color: var(--muted); font-size: .8rem; }
.back-to-top {
  position: fixed;
  z-index: 50;
  bottom: max(14px, env(safe-area-inset-bottom));
  left: max(14px, env(safe-area-inset-left));
  display: grid;
  width: 48px;
  height: 48px;
  place-items: center;
  padding: 0;
  border: 1px solid var(--line);
  border-radius: 14px;
  color: var(--forest);
  background: var(--soft);
  box-shadow: 0 10px 24px rgb(23 62 53 / 16%);
  font: 850 1.3rem / 1 Inter, ui-sans-serif, system-ui, sans-serif;
}
.back-to-top:hover { border-color: var(--sage); background: #dcecdf; }
.page-counter {
  position: fixed;
  z-index: 48;
  right: max(12px, env(safe-area-inset-right));
  bottom: max(14px, env(safe-area-inset-bottom));
  margin: 0;
  padding: 7px 9px;
  border: 1px solid rgb(216 229 220 / 90%);
  border-radius: 9px;
  color: var(--muted);
  background: rgb(255 255 255 / 82%);
  box-shadow: 0 8px 20px rgb(23 62 53 / 8%);
  font-size: .72rem;
  font-variant-numeric: tabular-nums;
  line-height: 1;
  pointer-events: none;
}
.toast {
  position: fixed;
  z-index: 90;
  bottom: 20px;
  left: 50%;
  width: min(430px, calc(100% - 32px));
  padding: 12px 14px;
  border-radius: var(--radius);
  color: var(--white);
  background: var(--forest);
  box-shadow: var(--shadow-hover);
  font-size: .9rem;
  opacity: 0;
  pointer-events: none;
  transform: translate(-50%, 16px);
  transition: opacity .18s ease, transform .18s ease;
}
.toast.is-visible { opacity: 1; transform: translate(-50%, 0); }
.search-result { outline: 3px solid #f0d772; outline-offset: 3px; }

@media (max-width: 720px) {
  .fact-grid, .ingredient-grid, .recipe-intro { grid-template-columns: 1fr; }
  .variant-card { grid-template-columns: 1fr; }
  .variant-card img { height: 220px; min-height: 0; }
  .recipe-intro figure { order: -1; }
  .variant-time { grid-template-columns: 1fr; gap: 3px; }
  .steps li { grid-template-columns: 40px 1fr; gap: 11px; }
  .steps li > span { width: 38px; height: 38px; }
  .steps time { float: none; display: block; margin-top: 3px; }
}

@media (max-width: 620px) {
  .site-header__inner { min-height: 58px; padding-inline: 16px; }
  .brand { font-size: 1rem; }
  .brand__mark { width: 32px; height: 32px; }
  .menu__panel { position: fixed; top: 64px; right: 12px; left: 12px; width: auto; }
  .hero { padding: 33px 20px 34px; }
  .page-shell { padding: 22px 16px 56px; }
  .hero__actions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); width: 100%; }
  .hero__actions .button { width: 100%; min-width: 0; padding-inline: 8px; white-space: nowrap; font-size: .88rem; }
  .article > section { margin-top: 38px; }
  .article > section:first-of-type { margin-top: 0; }
  .structure, .health { padding: 17px; }
  .recipe-meta { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .recipe-meta .total:last-child:nth-child(odd) { grid-column: 1 / -1; }
  .health .table-wrap { width: calc(100vw - 24px); }
  .sources summary { align-items: flex-start; }
  .page-counter { right: 10px; bottom: 12px; }
  .back-to-top { left: 10px; bottom: 10px; }
}

@media print {
  @page { size: A4; margin: 14mm 14mm 18mm; }
  html, body { color: #111; background: #fff; font-size: 10.4pt; }
  .site-header, .hero__actions, .site-footer, .back-to-top, .page-counter, .toast { display: none !important; }
  .hero { padding: 0 0 8mm; color: #111; background: none; }
  .hero h1 { max-width: none; color: #111; font-size: 26pt; }
  .hero__lead, .page-meta { color: #333; }
  .page-shell { width: 100%; padding: 0; }
  .article > section { margin-top: 8mm; break-inside: auto; scroll-margin-top: 0; }
  .research-note, .structure, .health, .variant-card, .ingredient-grid article, .source-note, .sources { box-shadow: none; }
  .variant-card { grid-template-columns: 42mm 1fr; break-inside: avoid; }
  .variant-card img { height: 45mm; min-height: 0; }
  .recipe { break-before: page; }
  .recipe-intro, .recipe-meta, .steps li, figure { break-inside: avoid; }
  .health { break-before: page; padding: 0; border: 0; }
  .health .table-wrap { width: 100%; max-width: none; margin-left: 0; overflow: visible; transform: none; border: 0; box-shadow: none; }
  table { min-width: 0; table-layout: fixed; font-size: 7pt; }
  th, td { padding: 4px; }
  .chip { padding: 2px 3px; }
  .sources-section { break-before: page; }
  .sources > div { display: block !important; }
  .sources summary { display: none; }
}
